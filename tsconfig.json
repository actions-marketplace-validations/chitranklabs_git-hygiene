{
  "compilerOptions": {
    /* Base Options: */
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "allowJs": true,
    "checkJs": true,
    /* Strictness: */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    /* Distribution: */
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "dist", "packages/*/dist", "app", ".next", ".turbo"]
}
