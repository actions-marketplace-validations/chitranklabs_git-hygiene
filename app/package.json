{
  "name": "git-hygiene-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node ../scripts/generate-web-changelog.mjs && node scripts/sync-identity.mjs",
    "predev": "pnpm --filter @chitrank2050/git-hygiene-core build && node ../scripts/generate-web-changelog.mjs && node scripts/sync-identity.mjs",
    "dev": "next dev --port 3005",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next out",
    "test:seo": "node scripts/seo-integration-test.mjs",
    "test:sandbox": "node --test scripts/sandbox-validation.test.mjs"
  },
  "dependencies": {
    "@chitrank2050/git-hygiene-core": "workspace:*",
    "@chitrank2050/monoline-ui": "^0.5.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "next": "^16.3.8",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^6.0.3"
  }
}
