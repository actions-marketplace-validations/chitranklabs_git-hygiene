{
  "name": "git-hygiene-workspace",
  "private": true,
  "version": "0.5.1",
  "description": "The ultimate zero-dependency metadata validator for modern Git workflows. Enforce conventional commits, branch naming patterns, and PR titles with blazing-fast native Node.js performance.",
  "author": {
    "name": "Chitrank Agnihotri",
    "email": "chitrank2050@gmail.com",
    "url": "https://www.chitrankagnihotri.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chitranklabs/git-hygiene"
  },
  "bugs": {
    "url": "https://github.com/chitranklabs/git-hygiene/issues"
  },
  "homepage": "https://github.com/chitranklabs/git-hygiene",
  "keywords": [
    "git",
    "conventional-commits",
    "branch-naming",
    "github-actions",
    "lint",
    "hygiene",
    "developer-experience",
    "dx",
    "commitlint",
    "metadata",
    "automation",
    "jsr",
    "npm",
    "zero-dependency",
    "typescript",
    "native-ts"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "clean": "turbo clean && rm -rf .turbo coverage",
    "build": "turbo build && pnpm build:action",
    "build:action": "esbuild packages/cli/src/cli.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/action.js --minify",
    "test": "turbo test",
    "test:cov": "turbo test:cov",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:md": "markdownlint --fix \"**/*.md\" --ignore node_modules",
    "lint:branch": "node --experimental-strip-types packages/cli/src/cli.ts branch",
    "lint:commit": "node --experimental-strip-types packages/cli/src/cli.ts commit",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "dev": "turbo dev",
    "deps:update": "pnpm update --interactive --latest -r",
    "changeset": "changeset",
    "version:packages": "changeset version && node scripts/sync-jsr-versions.mjs",
    "changelog": "bash scripts/generate-changelog.sh",
    "tag": "bash scripts/git-tag.sh",
    "release": "pnpm build && node --experimental-strip-types packages/cli/src/cli.ts bump && pnpm changelog && echo 'Ready to publish!'"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^17.5.0",
    "lefthook": "^2.1.6",
    "markdownlint-cli": "^0.49.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.26.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=9.0.0"
  },
  "git-hygiene": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "types": [
      "feat",
      "fix",
      "chore",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "revert",
      "maintenance",
      "renovate"
    ]
  }
}
